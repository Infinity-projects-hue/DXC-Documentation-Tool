# DXC AI Analyzer — copy to .env.local for local development

# Preferred provider: openai, gemini, google, anthropic, or claude
AI_PROVIDER=gemini

# Google Gemini / Google AI Studio
GEMINI_API_KEY=
# GOOGLE_API_KEY=              # Optional alias
# GEMINI_MODEL=gemini-flash-latest

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=              # Optional alias
# ANTHROPIC_MODEL=claude-haiku-4-5

# Generic alternative. Use only with AI_PROVIDER.
# AI_API_KEY=
# AI_MODEL=
